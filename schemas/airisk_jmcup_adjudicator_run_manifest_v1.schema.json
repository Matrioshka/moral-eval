{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moral-eval.local/schemas/airisk_jmcup_adjudicator_run_manifest_v1.schema.json",
  "title": "airisk_jmcup_adjudicator_run_manifest_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "created_at_utc", "adjudicator_run_id", "provider",
    "requested_model", "selected_generation_group_ids", "prompt_version",
    "prompt_sha256", "input_schema_sha256", "response_schema_sha256",
    "run_record_schema_sha256", "reviewer_input_schema_sha256",
    "reviewer_response_schema_sha256", "model_settings", "max_retries",
    "semantic_truth_deterministically_established"
  ],
  "properties": {
    "schema_version": {"const": "airisk_jmcup_adjudicator_run_manifest_v1"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "adjudicator_run_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "enum": ["anthropic", "openrouter"]},
    "requested_model": {"const": "anthropic/claude-opus-5"},
    "selected_generation_group_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^airisk_generation_group_[0-9]{4}$"}
    },
    "prompt_version": {"const": "airisk_jmcup_opus_adjudication_v1"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "input_schema_sha256": {"$ref": "#/$defs/sha256"},
    "response_schema_sha256": {"$ref": "#/$defs/sha256"},
    "run_record_schema_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_input_schema_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer_response_schema_sha256": {"$ref": "#/$defs/sha256"},
    "model_settings": {
      "type": "object", "additionalProperties": false,
      "required": ["temperature", "max_output_tokens"],
      "properties": {
        "temperature": {"type": ["number", "null"]},
        "max_output_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "max_retries": {"type": "integer", "minimum": 0},
    "semantic_truth_deterministically_established": {"const": false}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
