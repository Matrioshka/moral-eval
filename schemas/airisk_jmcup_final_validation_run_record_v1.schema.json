{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moral-eval.local/schemas/airisk_jmcup_final_validation_run_record_v1.schema.json",
  "title": "airisk_jmcup_final_validation_run_record_v1",
  "description": "One durable independent semantic-validation result. Raw provider material is referenced by hash only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_schema_version", "final_validation_run_id", "transformation_id",
    "provider", "requested_model", "resolved_reported_model",
    "provider_request_id", "provider_generation_id", "actual_routed_provider",
    "provider_usage", "aggregate_usage", "output_termination", "prompt_version",
    "prompt_sha256", "validator_response_schema_sha256",
    "canonical_final_validation_schema_sha256", "input_payload_sha256",
    "private_mapping_sha256", "transport_schema_sha256", "status",
    "parsed_validator_response", "canonical_final_validation_record",
    "canonical_final_validation_record_sha256", "final_attempt_provenance",
    "timestamp_utc", "model_settings", "retry_information", "validation_errors",
    "provider_block_metadata", "semantic_truth_deterministically_established"
  ],
  "properties": {
    "record_schema_version": {"const": "airisk_jmcup_final_validation_run_record_v1"},
    "final_validation_run_id": {"type": "string", "minLength": 1},
    "transformation_id": {"type": "string", "pattern": "^airisk_jmcup_transform_[A-Za-z0-9._-]+$"},
    "provider": {"type": "string", "enum": ["anthropic", "gemini", "openrouter"]},
    "requested_model": {"type": "string", "minLength": 1},
    "resolved_reported_model": {"type": ["string", "null"]},
    "provider_request_id": {"type": ["string", "null"]},
    "provider_generation_id": {"type": ["string", "null"]},
    "actual_routed_provider": {"type": ["string", "null"]},
    "provider_usage": {"type": ["object", "null"]},
    "aggregate_usage": {"$ref": "#/$defs/aggregate_usage"},
    "output_termination": {"type": ["object", "null"]},
    "prompt_version": {"const": "airisk_jmcup_final_validator_v1"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "validator_response_schema_sha256": {"$ref": "#/$defs/sha256"},
    "canonical_final_validation_schema_sha256": {"$ref": "#/$defs/sha256"},
    "input_payload_sha256": {"$ref": "#/$defs/sha256"},
    "private_mapping_sha256": {"$ref": "#/$defs/sha256"},
    "transport_schema_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"type": "string", "enum": ["completed", "refused", "blocked", "truncated", "validation_failed", "provider_error"]},
    "parsed_validator_response": {"type": ["object", "null"]},
    "canonical_final_validation_record": {"type": ["object", "null"]},
    "canonical_final_validation_record_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "final_attempt_provenance": {"$ref": "#/$defs/final_attempt"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "model_settings": {
      "type": "object", "additionalProperties": false,
      "required": ["temperature", "max_output_tokens"],
      "properties": {
        "temperature": {"type": ["number", "null"]},
        "max_output_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "retry_information": {
      "type": "object", "additionalProperties": false,
      "required": ["max_retries", "attempt_count", "attempts"],
      "properties": {
        "max_retries": {"type": "integer", "minimum": 0},
        "attempt_count": {"type": "integer", "minimum": 1},
        "attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attempt"}}
      }
    },
    "validation_errors": {"type": "array", "items": {"type": "string"}},
    "provider_block_metadata": {"type": ["object", "null"]},
    "semantic_truth_deterministically_established": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_count": {"type": ["integer", "null"], "minimum": 0},
    "nullable_cost": {"type": ["number", "null"], "minimum": 0},
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "reasoning_tokens", "cached_tokens", "total_tokens", "cost", "native_usage"],
      "properties": {
        "prompt_tokens": {"$ref": "#/$defs/nullable_count"},
        "completion_tokens": {"$ref": "#/$defs/nullable_count"},
        "reasoning_tokens": {"$ref": "#/$defs/nullable_count"},
        "cached_tokens": {"$ref": "#/$defs/nullable_count"},
        "total_tokens": {"$ref": "#/$defs/nullable_count"},
        "cost": {"$ref": "#/$defs/nullable_cost"},
        "native_usage": {"type": ["object", "null"]}
      }
    },
    "aggregate_usage": {
      "type": "object", "additionalProperties": false,
      "required": ["prompt_tokens", "completion_tokens", "reasoning_tokens", "cached_tokens", "total_tokens", "cost", "reported_attempt_counts"],
      "properties": {
        "prompt_tokens": {"$ref": "#/$defs/nullable_count"},
        "completion_tokens": {"$ref": "#/$defs/nullable_count"},
        "reasoning_tokens": {"$ref": "#/$defs/nullable_count"},
        "cached_tokens": {"$ref": "#/$defs/nullable_count"},
        "total_tokens": {"$ref": "#/$defs/nullable_count"},
        "cost": {"$ref": "#/$defs/nullable_cost"},
        "reported_attempt_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["prompt_tokens", "completion_tokens", "reasoning_tokens", "cached_tokens", "total_tokens", "cost"],
          "properties": {
            "prompt_tokens": {"type": "integer", "minimum": 0},
            "completion_tokens": {"type": "integer", "minimum": 0},
            "reasoning_tokens": {"type": "integer", "minimum": 0},
            "cached_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0},
            "cost": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_number", "status", "raw_provider_output_sha256", "resolved_reported_model", "provider_request_id", "provider_generation_id", "actual_routed_provider", "finish_reason", "output_termination", "usage", "provider_block_metadata", "validation_errors", "error"],
      "properties": {
        "attempt_number": {"type": "integer", "minimum": 1},
        "status": {"type": "string", "enum": ["completed", "refused", "blocked", "truncated", "validation_failed", "provider_error"]},
        "raw_provider_output_sha256": {"$ref": "#/$defs/sha256"},
        "resolved_reported_model": {"type": ["string", "null"]},
        "provider_request_id": {"type": ["string", "null"]},
        "provider_generation_id": {"type": ["string", "null"]},
        "actual_routed_provider": {"type": ["string", "null"]},
        "finish_reason": {"type": ["string", "null"]},
        "output_termination": {"type": ["object", "null"]},
        "usage": {"$ref": "#/$defs/usage"},
        "provider_block_metadata": {"type": ["object", "null"]},
        "validation_errors": {"type": "array", "items": {"type": "string"}},
        "error": {"type": ["string", "null"]}
      }
    },
    "final_attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_number", "raw_provider_output_sha256", "resolved_reported_model", "provider_request_id", "provider_generation_id", "actual_routed_provider", "provider_usage", "output_termination", "provider_block_metadata"],
      "properties": {
        "attempt_number": {"type": "integer", "minimum": 1},
        "raw_provider_output_sha256": {"$ref": "#/$defs/sha256"},
        "resolved_reported_model": {"type": ["string", "null"]},
        "provider_request_id": {"type": ["string", "null"]},
        "provider_generation_id": {"type": ["string", "null"]},
        "actual_routed_provider": {"type": ["string", "null"]},
        "provider_usage": {"type": ["object", "null"]},
        "output_termination": {"type": ["object", "null"]},
        "provider_block_metadata": {"type": ["object", "null"]}
      }
    }
  }
}
