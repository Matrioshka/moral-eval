{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moral-eval.local/schemas/airisk_jmcup_human_review_audit_v1.schema.json",
  "title": "airisk_jmcup_human_review_audit_v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "review_stage", "queue_jsonl_sha256", "decision_ledger_sha256", "queue_count", "decision_count", "active_count", "superseded_count", "stale_count", "decisions"],
  "properties": {
    "schema_version": {"const": "airisk_jmcup_human_review_audit_v1"},
    "review_stage": {"type": "string", "enum": ["source_review_human_hold", "final_transformation_human_review"]},
    "queue_jsonl_sha256": {"$ref": "#/$defs/sha256"},
    "decision_ledger_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "queue_count": {"type": "integer", "minimum": 0},
    "decision_count": {"type": "integer", "minimum": 0},
    "active_count": {"type": "integer", "minimum": 0},
    "superseded_count": {"type": "integer", "minimum": 0},
    "stale_count": {"type": "integer", "minimum": 0},
    "decisions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["decision_id", "case_id", "review_target_sha256", "status", "stale_reason", "supersedes_decision_id"], "properties": {
      "decision_id": {"type": "string", "minLength": 1}, "case_id": {"type": "string", "minLength": 1}, "review_target_sha256": {"$ref": "#/$defs/sha256"},
      "status": {"type": "string", "enum": ["active_current", "active_stale", "superseded_current", "superseded_stale"]},
      "stale_reason": {"type": ["string", "null"]}, "supersedes_decision_id": {"type": ["string", "null"]}
    }}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
