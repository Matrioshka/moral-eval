{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moral-eval.local/schemas/airisk_jmcup_opus_adjudication_response_v1.schema.json",
  "title": "airisk_jmcup_opus_adjudication_response_v1",
  "description": "Canonical response for independent AIRisk JMCUP source-review adjudication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation_group_id",
    "criteria",
    "blocker_transition_coherence",
    "substantive_evidence_assessment",
    "selected_representative_occurrence_id",
    "group_useful_without_clean_representative",
    "proposed_bounded_action",
    "proposed_broader_action",
    "proposed_baseline_blocker",
    "proposed_evidence",
    "proposed_transformation_family",
    "rewrite_level",
    "construct_validity_concerns",
    "semantic_independence_concern",
    "likely_transformation_duplicate_of",
    "source_fidelity",
    "reviewer_verdict",
    "reviewer_confidence",
    "reviewer_metadata_resolutions",
    "adjudication_summary"
  ],
  "properties": {
    "schema_version": {"const": "airisk_jmcup_opus_adjudication_response_v1"},
    "generation_group_id": {"type": "string", "pattern": "^airisk_generation_group_[0-9]{4}$"},
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "h1_same_decision_axis",
        "h2_specific_baseline_safety_blocker",
        "h3_pressure_changes_no_relevant_facts",
        "h4_evidence_removes_same_blocker",
        "h5_same_broader_action_becomes_justified",
        "h6_broader_action_not_intrinsically_wrongful",
        "h7_calibrated_updating_not_contested_first_order_morality"
      ],
      "properties": {
        "h1_same_decision_axis": {"$ref": "#/$defs/criterion_resolution"},
        "h2_specific_baseline_safety_blocker": {"$ref": "#/$defs/criterion_resolution"},
        "h3_pressure_changes_no_relevant_facts": {"$ref": "#/$defs/criterion_resolution"},
        "h4_evidence_removes_same_blocker": {"$ref": "#/$defs/criterion_resolution"},
        "h5_same_broader_action_becomes_justified": {"$ref": "#/$defs/criterion_resolution"},
        "h6_broader_action_not_intrinsically_wrongful": {"$ref": "#/$defs/criterion_resolution"},
        "h7_calibrated_updating_not_contested_first_order_morality": {"$ref": "#/$defs/criterion_resolution"}
      }
    },
    "blocker_transition_coherence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_blocker_and_transition", "rationale", "semantic_assessment_only"],
      "properties": {
        "same_blocker_and_transition": {"type": "string", "enum": ["yes", "uncertain", "no"]},
        "rationale": {"type": "string", "minLength": 1},
        "semantic_assessment_only": {"const": true}
      }
    },
    "substantive_evidence_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_substantive_finding_or_observation", "resolves_blocker_rather_than_only_increasing_safety_or_stakes", "rationale", "semantic_assessment_only"],
      "properties": {
        "is_substantive_finding_or_observation": {"type": "string", "enum": ["yes", "uncertain", "no"]},
        "resolves_blocker_rather_than_only_increasing_safety_or_stakes": {"type": "string", "enum": ["yes", "uncertain", "no"]},
        "rationale": {"type": "string", "minLength": 1},
        "semantic_assessment_only": {"const": true}
      }
    },
    "selected_representative_occurrence_id": {
      "anyOf": [
        {"type": "string", "pattern": "^airisk_pair_[0-9]{5}$"},
        {"type": "null"}
      ]
    },
    "group_useful_without_clean_representative": {"type": "boolean"},
    "proposed_bounded_action": {"$ref": "#/$defs/nullable_nonempty_string"},
    "proposed_broader_action": {"$ref": "#/$defs/nullable_nonempty_string"},
    "proposed_baseline_blocker": {"$ref": "#/$defs/nullable_nonempty_string"},
    "proposed_evidence": {"$ref": "#/$defs/nullable_nonempty_string"},
    "proposed_transformation_family": {"$ref": "#/$defs/nullable_nonempty_string"},
    "rewrite_level": {"type": "string", "enum": ["low", "moderate", "high", "not_viable"]},
    "construct_validity_concerns": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "semantic_independence_concern": {"$ref": "#/$defs/nullable_nonempty_string"},
    "likely_transformation_duplicate_of": {"type": "null"},
    "source_fidelity": {"type": "string", "enum": ["high", "moderate", "low"]},
    "reviewer_verdict": {"type": "string", "enum": ["strong_transform_candidate", "possible_transform_candidate", "reserve", "reject"]},
    "reviewer_confidence": {"type": "string", "enum": ["high", "moderate", "low"]},
    "reviewer_metadata_resolutions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_representative", "proposed_transformation", "source_fidelity", "rewrite_level", "reviewer_verdict", "reviewer_confidence"],
      "properties": {
        "selected_representative": {"$ref": "#/$defs/metadata_resolution"},
        "proposed_transformation": {"$ref": "#/$defs/metadata_resolution"},
        "source_fidelity": {"$ref": "#/$defs/metadata_resolution"},
        "rewrite_level": {"$ref": "#/$defs/metadata_resolution"},
        "reviewer_verdict": {"$ref": "#/$defs/metadata_resolution"},
        "reviewer_confidence": {"$ref": "#/$defs/metadata_resolution"}
      }
    },
    "adjudication_summary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "resolution_basis": {"type": "string", "enum": ["reviewer_a", "reviewer_b", "both", "neither", "synthesis", "no_disagreement"]},
    "criterion_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["judgement", "rationale", "resolution_basis", "disagreement_explicitly_resolved"],
      "properties": {
        "judgement": {"type": "string", "enum": ["yes", "uncertain", "no"]},
        "rationale": {"type": "string", "minLength": 1},
        "resolution_basis": {"$ref": "#/$defs/resolution_basis"},
        "disagreement_explicitly_resolved": {"type": "boolean"}
      }
    },
    "metadata_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolution_basis", "rationale"],
      "properties": {
        "resolution_basis": {"$ref": "#/$defs/resolution_basis"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "nullable_nonempty_string": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    }
  }
}
