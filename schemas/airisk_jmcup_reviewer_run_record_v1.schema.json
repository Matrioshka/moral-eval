{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moral-eval.local/schemas/airisk_jmcup_reviewer_run_record_v1.schema.json",
  "title": "airisk_jmcup_reviewer_run_record_v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "output_termination": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finish_reason",
            "native_finish_reason",
            "output_limit_reached",
            "valid_complete_response_recovered"
          ],
          "properties": {
            "finish_reason": {"type": ["string", "null"]},
            "native_finish_reason": {"type": ["string", "null"]},
            "output_limit_reached": {"type": "boolean"},
            "valid_complete_response_recovered": {"type": "boolean"}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "valid_complete_response_recovered": {"const": true}
                },
                "required": ["valid_complete_response_recovered"]
              },
              "then": {
                "properties": {"output_limit_reached": {"const": true}}
              }
            }
          ]
        },
        {"type": "null"}
      ]
    },
    "normalised_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_tokens",
        "completion_tokens",
        "reasoning_tokens",
        "cached_tokens",
        "total_tokens",
        "cost"
      ],
      "properties": {
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "aggregate_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt_tokens",
        "completion_tokens",
        "reasoning_tokens",
        "cached_tokens",
        "total_tokens",
        "cost",
        "reported_attempt_counts"
      ],
      "properties": {
        "prompt_tokens": {"type": ["integer", "null"], "minimum": 0},
        "completion_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost": {"type": ["number", "null"], "minimum": 0},
        "reported_attempt_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt_tokens",
            "completion_tokens",
            "reasoning_tokens",
            "cached_tokens",
            "total_tokens",
            "cost"
          ],
          "properties": {
            "prompt_tokens": {"type": "integer", "minimum": 0},
            "completion_tokens": {"type": "integer", "minimum": 0},
            "reasoning_tokens": {"type": "integer", "minimum": 0},
            "cached_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0},
            "cost": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_number",
        "timestamp_utc",
        "status",
        "resolved_reported_model",
        "provider_request_id",
        "provider_generation_id",
        "actual_routed_provider",
        "provider_usage",
        "normalised_usage",
        "output_termination",
        "provider_block_metadata",
        "validation_errors",
        "error_type",
        "error_message",
        "retry_delay_seconds"
      ],
      "properties": {
        "attempt_number": {"type": "integer", "minimum": 1},
        "timestamp_utc": {"type": "string", "format": "date-time"},
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "validation_failed",
            "provider_error",
            "refused",
            "blocked",
            "truncated"
          ]
        },
        "resolved_reported_model": {"type": ["string", "null"]},
        "provider_request_id": {"type": ["string", "null"]},
        "provider_generation_id": {"type": ["string", "null"]},
        "actual_routed_provider": {"type": ["string", "null"]},
        "provider_usage": {
          "description": "Complete native usage and cost details for this attempt, when returned.",
          "anyOf": [{"type": "object"}, {"type": "null"}]
        },
        "normalised_usage": {"$ref": "#/$defs/normalised_usage"},
        "output_termination": {"$ref": "#/$defs/output_termination"},
        "provider_block_metadata": {
          "anyOf": [{"type": "object"}, {"type": "null"}]
        },
        "validation_errors": {"type": "array", "items": {"type": "string"}},
        "error_type": {"type": ["string", "null"]},
        "error_message": {"type": ["string", "null"]},
        "retry_delay_seconds": {"type": ["number", "null"], "minimum": 0}
      }
    }
  },
  "required": [
    "record_schema_version",
    "reviewer_run_id",
    "generation_group_id",
    "provider",
    "requested_model",
    "resolved_reported_model",
    "provider_request_id",
    "provider_generation_id",
    "actual_routed_provider",
    "provider_usage",
    "aggregate_usage",
    "output_termination",
    "provider_reasoning",
    "prompt_version",
    "prompt_sha256",
    "response_schema_sha256",
    "input_payload_sha256",
    "status",
    "raw_response",
    "raw_response_text",
    "parsed_structured_response",
    "provider_block_metadata",
    "timestamp_utc",
    "model_settings",
    "retry_information",
    "validation_errors"
  ],
  "properties": {
    "record_schema_version": {"const": "airisk_jmcup_reviewer_run_record_v1"},
    "reviewer_run_id": {"type": "string", "minLength": 1},
    "generation_group_id": {"type": "string", "pattern": "^airisk_generation_group_[0-9]{4}$"},
    "provider": {"type": "string", "enum": ["anthropic", "gemini", "openrouter"]},
    "requested_model": {"type": "string", "minLength": 1},
    "resolved_reported_model": {"type": ["string", "null"]},
    "provider_request_id": {"type": ["string", "null"]},
    "provider_generation_id": {"type": ["string", "null"]},
    "actual_routed_provider": {"type": ["string", "null"]},
    "provider_usage": {
      "description": "Complete native usage and cost details for the final attempt only; aggregate_usage covers all attempts.",
      "anyOf": [{"type": "object"}, {"type": "null"}]
    },
    "aggregate_usage": {"$ref": "#/$defs/aggregate_usage"},
    "output_termination": {
      "description": "Final-attempt finish and output-limit provenance.",
      "$ref": "#/$defs/output_termination"
    },
    "provider_reasoning": {
      "description": "Final-attempt provider reasoning fields, preserved when returned."
    },
    "prompt_version": {"const": "airisk_jmcup_group_semantic_review_v1"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "validation_failed",
        "provider_error",
        "refused",
        "blocked",
        "truncated"
      ]
    },
    "raw_response": {},
    "raw_response_text": {"type": ["string", "null"]},
    "parsed_structured_response": {
      "anyOf": [{"type": "object"}, {"type": "null"}]
    },
    "provider_block_metadata": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "provider_signal",
            "native_code",
            "category",
            "explanation",
            "details"
          ],
          "properties": {
            "provider": {"type": "string", "enum": ["anthropic", "gemini", "openrouter"]},
            "provider_signal": {"type": "string", "minLength": 1},
            "native_code": {"type": "string", "minLength": 1},
            "category": {"type": ["string", "null"]},
            "explanation": {"type": ["string", "null"]},
            "details": {}
          }
        },
        {"type": "null"}
      ]
    },
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "model_settings": {"type": "object"},
    "retry_information": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retries", "attempt_count", "attempts"],
      "properties": {
        "max_retries": {"type": "integer", "minimum": 0},
        "attempt_count": {"type": "integer", "minimum": 1},
        "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}}
      }
    },
    "validation_errors": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"enum": ["refused", "blocked"]}},
        "required": ["status"]
      },
      "then": {"properties": {"provider_block_metadata": {"type": "object"}}}
    },
    {
      "if": {
        "properties": {"status": {"const": "refused"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "provider": {"enum": ["anthropic", "openrouter"]},
          "parsed_structured_response": {"type": "null"},
          "provider_block_metadata": {
            "type": "object",
            "properties": {"native_code": {"const": "refusal"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "blocked"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "provider": {"enum": ["gemini", "openrouter"]},
          "parsed_structured_response": {"type": "null"},
          "provider_block_metadata": {"type": "object"}
        }
      }
    },
    {
      "if": {
        "properties": {"status": {"const": "truncated"}},
        "required": ["status"]
      },
      "then": {
        "properties": {
          "parsed_structured_response": {"type": "null"},
          "provider_block_metadata": {"type": "null"},
          "output_termination": {
            "type": "object",
            "properties": {
              "output_limit_reached": {"const": true},
              "valid_complete_response_recovered": {"const": false}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "completed"},
          "output_termination": {
            "type": "object",
            "properties": {"output_limit_reached": {"const": true}},
            "required": ["output_limit_reached"]
          }
        },
        "required": ["status", "output_termination"]
      },
      "then": {
        "properties": {
          "output_termination": {
            "type": "object",
            "properties": {
              "valid_complete_response_recovered": {"const": true}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {"const": "anthropic"},
          "status": {"const": "refused"}
        },
        "required": ["provider", "status"]
      },
      "then": {
        "properties": {
          "provider_block_metadata": {
            "properties": {"provider": {"const": "anthropic"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {"const": "gemini"},
          "status": {"const": "blocked"}
        },
        "required": ["provider", "status"]
      },
      "then": {
        "properties": {
          "provider_block_metadata": {
            "properties": {"provider": {"const": "gemini"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {"const": "openrouter"},
          "status": {"enum": ["refused", "blocked"]}
        },
        "required": ["provider", "status"]
      },
      "then": {
        "properties": {
          "provider_block_metadata": {
            "properties": {"provider": {"const": "openrouter"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["completed", "validation_failed", "provider_error", "truncated"]
          }
        },
        "required": ["status"]
      },
      "then": {"properties": {"provider_block_metadata": {"type": "null"}}}
    }
  ]
}
