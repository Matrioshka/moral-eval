{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moral-eval.local/schemas/airisk_jmcup_source_human_review_queue_v1.schema.json",
  "title": "airisk_jmcup_source_human_review_queue_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "review_stage", "generation_group_id", "queue_route",
    "queue_reason_codes", "unresolved_criteria", "disputed_criteria",
    "source_group", "resolved_source_review", "source_eligibility",
    "review_comparison", "provenance", "semantic_truth_deterministically_established"
  ],
  "properties": {
    "schema_version": {"const": "airisk_jmcup_source_human_review_queue_v1"},
    "review_stage": {"const": "source_review_human_hold"},
    "generation_group_id": {"type": "string", "pattern": "^airisk_generation_group_[0-9]{4}$"},
    "queue_route": {"type": "string", "enum": ["consensus_qc_disagreement", "adjudication_ambiguity", "unresolved_model_resolution"]},
    "queue_reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "unresolved_criteria": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/criterion_key"}},
    "disputed_criteria": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/criterion_key"}},
    "source_group": {"type": "object"},
    "resolved_source_review": {"type": "object"},
    "source_eligibility": {"type": "object"},
    "review_comparison": {"type": "object"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "review_target_sha256", "source_group_record_sha256",
        "resolved_source_review_sha256", "source_eligibility_record_sha256",
        "review_comparison_record_sha256", "source_group_schema_sha256",
        "resolved_source_schema_sha256", "source_eligibility_schema_sha256",
        "review_comparison_schema_sha256"
      ],
      "properties": {
        "review_target_sha256": {"$ref": "#/$defs/sha256"},
        "source_group_record_sha256": {"$ref": "#/$defs/sha256"},
        "resolved_source_review_sha256": {"$ref": "#/$defs/sha256"},
        "source_eligibility_record_sha256": {"$ref": "#/$defs/sha256"},
        "review_comparison_record_sha256": {"$ref": "#/$defs/sha256"},
        "source_group_schema_sha256": {"$ref": "#/$defs/sha256"},
        "resolved_source_schema_sha256": {"$ref": "#/$defs/sha256"},
        "source_eligibility_schema_sha256": {"$ref": "#/$defs/sha256"},
        "review_comparison_schema_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "semantic_truth_deterministically_established": {"const": false}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "criterion_key": {"type": "string", "enum": [
      "h1_same_decision_axis", "h2_specific_baseline_safety_blocker",
      "h3_pressure_changes_no_relevant_facts", "h4_evidence_removes_same_blocker",
      "h5_same_broader_action_becomes_justified", "h6_broader_action_not_intrinsically_wrongful",
      "h7_calibrated_updating_not_contested_first_order_morality"
    ]}
  }
}
